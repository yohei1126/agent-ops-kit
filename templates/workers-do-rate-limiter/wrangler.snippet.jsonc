// Copy these two entries into your own wrangler.jsonc.
//
// 1. Add the binding under `durable_objects.bindings`.
// 2. Append the migration after every migration already in the file.
//
// The migration tag is a placeholder. Replace it with your next tag, such as
// the next number in your own sequence. Never edit a migration that has already
// been applied; append a new one instead.
{
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "YOUR_NEXT_MIGRATION_TAG",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]
}
