id=mcr.allow.script
effect=permit
principal=*
action=skip-model-check
resource=scripts/*.sh
when=slash_count=1
when=exists_at_mb=1
when=paired_test_at_mb=1
when=paired_test_at_head=1

id=mcr.allow.test
effect=permit
principal=*
action=skip-model-check
resource=scripts/tests/test_*.sh
when=slash_count=2
when=exists_at_mb=1

