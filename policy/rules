id=agent-git.forbid.git-add
effect=forbid
principal=*
action=agent-git.instruct
resource=*
when_ere=(^|[^[:alnum:]_])git[[:space:]]+add([^[:alnum:]_]|$)
label=git add

id=agent-git.forbid.git-commit
effect=forbid
principal=*
action=agent-git.instruct
resource=*
when_ere=(^|[^[:alnum:]_])git[[:space:]]+commit([^[:alnum:]_]|$)
label=git commit

id=agent-git.forbid.git-push
