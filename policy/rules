id=mcr.line-cap
effect=forbid
principal=*
action=skip-model-check
resource=*
when=changed_lines>150

id=mcr.script-and-test
effect=forbid
principal=*
action=skip-model-check
resource=scripts/*.sh
when=slash_count=1
when=paired_in_diff=1

id=mcr.allow.docs
effect=permit
principal=*
action=skip-model-check
resource=docs/*.md

